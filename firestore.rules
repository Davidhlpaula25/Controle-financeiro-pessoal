rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownsDocument() {
      return signedIn() && resource.data.uid == request.auth.uid;
    }

    function isOwnerOnCreate() {
      return signedIn() && request.resource.data.uid == request.auth.uid;
    }

    match /transactions/{transactionId} {
      allow read: if ownsDocument();
      allow create: if isOwnerOnCreate();
      allow update: if ownsDocument() && request.resource.data.uid == resource.data.uid;
      allow delete: if ownsDocument();
    }

    match /templates/{templateId} {
      allow read: if ownsDocument();
      allow create: if isOwnerOnCreate();
      allow update: if ownsDocument() && request.resource.data.uid == resource.data.uid;
      allow delete: if ownsDocument();
    }
  }
}
